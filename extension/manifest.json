{
  "manifest_version": 3,
  "name": "Relevé",
  "short_name": "Relevé",
  "version": "0.1.0",
  "description": "Sur une page produit Amazon ou Shopify : sa place dans les meilleures ventes relevées par Relevé, et sa rentabilité en un clic.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ouvrir Relevé",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mattrvfl.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.fr/*",
        "https://www.amazon.com/*",
        "https://*/products/*",
        "https://*/*/products/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-48.png"
      ],
      "matches": [
        "https://www.amazon.fr/*",
        "https://www.amazon.com/*",
        "https://*/*"
      ]
    }
  ]
}
